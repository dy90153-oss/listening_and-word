      "css": ".ds-button{font-family:var(--sans,\"Noto Sans TC\",\"PingFang TC\",\"Microsoft JhengHei\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:42px;min-height:58px;padding:14px 28px;border:0;border-radius:0;background:var(--green,#173f35);color:var(--paper,#f6f7f2);font-size:16px;font-weight:500;line-height:1.6;cursor:pointer;transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1)),background-color .25s}.ds-button:hover{background:#285a46}.ds-button:focus-visible{outline:3px solid currentColor;outline-offset:5px;}.ds-button:active{transform:translateY(2px)}.ds-button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
