  "narrative": {
    "northStar": "清朗服務",
    "overview": "使用者已選定的晴藍視覺方向，以清楚的繁體中文黑體、開闊留白與柔和圓角建立親切的專業感。深藍承擔閱讀、操作與品牌辨識，淺藍與白色負責區分資訊層次。",
    "keyCharacteristics": [
      "晴藍底色與清楚的深藍文字。",
      "單一黑體家族，以真實字重形成層次。",
      "扁平色面、功能性圓角與可見焦點。"
    ],
    "rules": [
      {
        "name": "The Single Blue World Rule",
        "body": "延伸頁面沿用此藍色系，不引入其他候選方向的綠色、海報紅或深色螢光美學。",
        "section": "colors"
      },
      {
        "name": "The Real Weight Rule",
        "body": "使用自託管可變字型提供的真實字重，不以假粗體或第二套展示字型製造層次。",
        "section": "typography"
      }
    ],
    "dos": [
      "Do 延續晴藍、近白與深藍的單一視覺世界。",
      "Do 保留清楚的數字、時間碼、表單狀態及鍵盤焦點。",
      "Do 在手機使用單欄與自然換行。"
    ],
    "donts": [
      "Don’t 混用其他四個候選版本的美學。",
      "Don’t 加入陰影、裝飾紋理或與服務無關的視覺素材。",
      "Don’t 將商業承諾或頁面排序當作全站視覺 token。"
    ]
  }
